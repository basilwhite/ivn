{
  "manifest_version": "1.0",
  "repo": "https://github.com/basilwhite/ivn",
  "last_updated": "2026-05-08",
  "description": "Completeness model for IVN repo. The recruiting agent diffs this manifest against the live repo file list and the normalized dataset tables to identify and score gaps.",

  "gap_scoring": {
    "description": "Each gap type has a severity weight (1–5). The recruiter multiplies weight by gap count to produce a priority score per run.",
    "weights": {
      "missing_alignment_citation":   5,
      "missing_alignment_rationale":  4,
      "missing_alignment_validation": 4,
      "missing_component_description":3,
      "missing_component_url":        2,
      "missing_required_file":        3,
      "missing_companion_prompt":     2,
      "stale_data_file":              1
    }
  },

  "schema_gap_rules": {
    "description": "Rules applied to the normalized Excel tables fetched from the repo. These run on every sweep independent of the file manifest.",
    "tables": {
      "Components": {
        "gap_type": "missing_component_description",
        "null_fields": ["component_description"],
        "sub_agent": "validator"
      },
      "Components_url": {
        "gap_type": "missing_component_url",
        "null_fields": ["component_url", "fetch_status"],
        "sub_agent": "validator"
      },
      "Alignments_citation": {
        "gap_type": "missing_alignment_citation",
        "null_fields": ["linkage_mandate"],
        "sub_agent": "mapper"
      },
      "Alignments_rationale": {
        "gap_type": "missing_alignment_rationale",
        "null_fields": ["alignment_rationale"],
        "sub_agent": "mapper"
      },
      "Alignments_validation": {
        "gap_type": "missing_alignment_validation",
        "null_fields": ["valid", "similarity", "confidence"],
        "sub_agent": "validator"
      },
      "Alignments_orphan": {
        "gap_type": "missing_alignment_citation",
        "description": "Component in Components table with zero rows in Alignments as enabling_component_id or dependent_component_id.",
        "sub_agent": "mapper"
      }
    }
  },

