  "recruiter_sweep_output": {
    "description": "Schema for the gap report the recruiter writes to staging/manifest.json on each sweep.",
    "fields": {
      "sweep_timestamp":    "ISO 8601 datetime",
      "trigger":            "scheduled | gap_threshold | manual",
      "schema_gaps": [
        {
          "gap_type":            "string — from gap_scoring.weights keys",
          "table":               "string — Components | Alignments",
          "field":               "string — field name with null value",
          "component_id":        "string or null",
          "enabling_component_id":"string or null",
          "dependent_component_id":"string or null",
          "severity":            "integer 1–5",
          "sub_agent_assigned":  "mapper | validator | coder | doc",
          "task_dispatched":     "boolean"
        }
      ],
      "file_gaps": [
        {
          "filename":            "string",
          "gap_type":            "string",
          "severity":            "integer 1–5",
          "sub_agent_assigned":  "coder | doc",
          "task_dispatched":     "boolean"
        }
      ],
      "total_priority_score":   "integer — sum of severity × gap count",
      "files_staged":           "integer — count of files dropped to staging this run",
      "alerts": [
        {
          "type":    "stale_data | budget_threshold | staging_backlog",
          "message": "string",
          "action":  "human_review"
        }
      ]
    }
  }
